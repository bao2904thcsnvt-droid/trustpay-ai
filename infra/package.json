{
  "name": "trustpay-ai-infra",
  "version": "1.0.0",
  "private": true,
  "description": "Hạ tầng AWS Serverless (CDK) cho TrustPay AI — tách biệt khỏi ứng dụng Next.js.",
  "bin": {
    "trustpay-infra": "bin/trustpay-app.ts"
  },
  "scripts": {
    "build": "tsc",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "deploy:serverless": "cdk deploy TrustPayServerlessStack",
    "destroy": "cdk destroy --all"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1173.0",
    "@aws-sdk/client-rekognition": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/client-translate": "^3.1173.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "aws-cdk": "^2.160.0",
    "esbuild": "^0.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.160.0",
    "constructs": "^10.3.0"
  }
}
